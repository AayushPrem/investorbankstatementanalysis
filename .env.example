# Copy to .env and fill in. Placeholders only — never commit a real key.
# Read by config/settings.py (path overridable with BSAA_ENV_FILE; empty disables).

# LLM (optional). Without a key every LLM path uses its deterministic fallback.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-haiku-4-5-20251001
LLM_ENABLED=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Data platform (Phase 2): Postgres, API, worker. docker-compose.yml sets these itself.
DATABASE_URL=postgresql+psycopg2://bsaa:change-me@localhost:5432/bsaa
# sha256 hex of the key clients send as X-API-Key. Generate with:
#   python -c "import hashlib,secrets; k=secrets.token_urlsafe(32); print(k); print(hashlib.sha256(k.encode()).hexdigest())"
# Unset → every /v1 request is refused (fail closed).
API_KEY_HASH=
MAX_UPLOAD_BYTES=20971520
JOB_LEASE_S=300
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_S=5
WORKER_POLL_S=1

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# ML artifacts / embeddings
MODELS_DIR=models
EMBEDDINGS_ENABLED=false
